NODE_ENV=production
PORT=3001
MONGO_URI="mongodb://{{ mongo_app_user | urlencode }}:{{ mongo_app_password | urlencode }}@{{ hostvars[groups['db'][0]].ansible_host }}:27017/{{ mongo_database | urlencode }}?authSource={{ mongo_database | urlencode }}"
CORS_ORIGIN=http://{{ ansible_host }}
